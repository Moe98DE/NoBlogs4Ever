{
    log default {
        output discard
    }
}
:80 {
    @invalid not host {$PLATFORM_DOMAIN} *.{$PLATFORM_DOMAIN}
    respond @invalid 421
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        ?Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    @secret path /wp-config.php /.env /xmlrpc.php /wp-cron.php /.git/* /wp-content/uploads/*.php /wp-content/uploads/*.phtml /wp-content/uploads/*.phar
    respond @secret 403
    reverse_proxy app:80
}
