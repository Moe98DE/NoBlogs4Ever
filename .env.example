# NoBlogs4Ever configuration. Copy to .env (`make init` does this) and adjust.
# Passwords and keys never go here: they live in secrets/ (see docs/operations/configuration.md).

# --- Platform -------------------------------------------------------------
# base domain; tenants get <slug>.<domain>. lvh.me resolves to 127.0.0.1
PLATFORM_DOMAIN=lvh.me
# https in production
PLATFORM_SCHEME=http
# development only; production uses 443
PLATFORM_PORT=8080
# development | production
APP_ENV=development
# production: registry reference pinned by @sha256 digest
NBE_APP_IMAGE=noblogs4ever:local
BRAND_NAME=NoBlogs4Ever
SUPPORT_EMAIL=support@example.invalid
NBE_ADMIN_EMAIL=operator@example.invalid
DEFAULT_THEME=twentytwentyfive
# extra site names to refuse, comma-separated
RESERVED_SLUGS=

# --- Email (Mailpit catches everything in development: http://localhost:8025)
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
# tls | ssl in production
SMTP_TLS=
SMTP_FROM=publisher@example.invalid
SMTP_TEST_RECIPIENT=
# network-wide outbound cap
MAIL_PER_HOUR=200

# --- Registration (operators can change these at runtime in Network Admin → Platform policy)
# invitation | approval | allowlist | unrestricted
REGISTRATION_POLICY=unrestricted
# production requires yes for unrestricted
NBE_ACK_OPEN_REGISTRATION=no
REGISTRATION_ALLOWLIST=
REGISTRATION_DENYLIST=
MAX_SITES_PER_USER=3
# operators always need MFA in production
REQUIRE_MFA_FOR_SITE_ADMINS=no

# --- Media and content ---------------------------------------------------
MAX_UPLOAD_MB=32
SITE_QUOTA_MB=1024
ALLOWED_EXTENSIONS=jpg,jpeg,jpe,png,gif,webp,pdf,txt,mp3,mp4,ods,odt
# larger images get a scaled copy; the original is kept
IMAGE_MAX_EDGE=2560
# e.g. www.openstreetmap.org — allowed <iframe> hosts (HTTPS only)
EMBED_IFRAME_HOSTS=
# yes lets reader browsers contact gravatar.com
ALLOW_GRAVATAR=no
# yes offers Polylang and ActivityPub to site admins
ENABLE_EXPERIMENTAL_INTEGRATIONS=no

# --- Privacy and retention ----------------------------------------------
ANALYTICS_RETENTION_DAYS=14
LOG_RETENTION_DAYS=7
SESSION_HOURS=24
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_MB=4096

# --- Migration -----------------------------------------------------------
MIGRATION_RETENTION_DAYS=30
MIGRATION_STALL_MINUTES=30
# seconds of import work per worker pass
MIGRATION_TIME_BUDGET=20
NBE_WORKER_INTERVAL=30

# --- Backups (Restic) ----------------------------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=26
# production: s3:… b2:… rest:… azure:…
RESTIC_REPOSITORY=/repository
RESTIC_BACKEND_ENV_FILE=secrets/restic_backend.env
RESTIC_AUTH_EXTERNAL_ACK=no
# production default: yes
BACKUP_REQUIRE_REMOTE=no
BACKUP_LOCAL_OFFHOST_ACK=no
MIN_FREE_GB=5
STORAGE_CHECK_PATH=.
